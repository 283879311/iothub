+/* ---- T5/T6 启动期一次性票据(RTC_NOINIT,不落 NVS) ---- */
+#define APP_WIFI_BOOT_TICKET_MAGIC 0x4D314246u   /* 'M1BF' */
+#define APP_WIFI_BOOT_TICKET_VERSION 1u
+#define APP_WIFI_BOOT_TICKET_PROBE_STAGE 0xFFFFu
+
+typedef struct {
+    uint32_t magic;
+    uint16_t version;
+    uint16_t stage;
+    uint8_t  count;
+    uint8_t  reserved[3];

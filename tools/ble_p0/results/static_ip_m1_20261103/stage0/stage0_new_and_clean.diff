+static void app_mqtt_publish_command_response(const char *topic, cJSON *resp)
+{
+    esp_mqtt_client_handle_t client;
+    char *body;
+
+    if (topic == NULL || resp == NULL) {
+        return;
+    }
+    client = app_mqtt_client_safe();
+    if (client == NULL) {
+        return;
+    }
+    body = cJSON_PrintUnformatted(resp);
+    if (body == NULL) {
+        return;
+    }
+    ESP_LOGI(TAG, "rpc resp -> %s: %.256s", topic, body);
+    esp_mqtt_client_publish(client, topic, body, 0, 1, 0);
+    cJSON_free(body);
+}
+
+static cJSON *app_mqtt_v1_error(const char *id, const char *code, const char *message)
+{
+    cJSON *root = cJSON_CreateObject();
+    cJSON *error;
+
+    if (root == NULL) {
+        return NULL;
+    }
+    cJSON_AddStringToObject(root, "id", id != NULL ? id : "");
+    cJSON_AddBoolToObject(root, "ok", false);
+    error = cJSON_AddObjectToObject(root, "error");
+    if (error != NULL) {
+        cJSON_AddStringToObject(error, "code", code != NULL ? code : "internal_error");
+        cJSON_AddStringToObject(error, "message", message != NULL ? message : "");
+    }
+    return root;
+}
+
+static cJSON *app_mqtt_v1_ok(const char *id, cJSON *result)
+{
+    cJSON *root = cJSON_CreateObject();
+
+    if (root == NULL) {
+        cJSON_Delete(result);
+        return NULL;
+    }
+    cJSON_AddStringToObject(root, "id", id != NULL ? id : "");
+    cJSON_AddBoolToObject(root, "ok", true);
+    if (result != NULL) {
+        cJSON_AddItemToObject(root, "result", result);
+    }
+    return root;
+}
+
+static const char *app_mqtt_v1_id_string(const cJSON *id_item, char *buf, size_t buf_size)
+{
+    if (cJSON_IsString(id_item) && id_item->valuestring != NULL) {
+        snprintf(buf, buf_size, "%s", id_item->valuestring);
+        return buf;
+    }
+    if (cJSON_IsNumber(id_item)) {
+        snprintf(buf, buf_size, "%lld", (long long)id_item->valuedouble);
+        return buf;
+    }
+    buf[0] = '\0';
+    return buf;
+}
+
+/* Stage 0 MQTT v1 adapter: only the network methods are mapped. */
+static cJSON *app_mqtt_execute_v1(const cJSON *root)
+{
+    const cJSON *id_item = cJSON_GetObjectItemCaseSensitive(root, "id");
+    const cJSON *cmd_item = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    const cJSON *args_item = cJSON_GetObjectItemCaseSensitive(root, "args");
+    char id_buf[65];
+    const char *id = app_mqtt_v1_id_string(id_item, id_buf, sizeof(id_buf));
+    const char *cmd;
+    app_cmd_context_t ctx = app_cmd_ctx_entry(APP_CMD_SOURCE_MQTT);
+    app_cmd_policy_result_t policy;
+
+    if (id_item == NULL || (!cJSON_IsString(id_item) && !cJSON_IsNumber(id_item))) {
+        return app_mqtt_v1_error("", "invalid_argument", "id required");
+    }
+    if (!cJSON_IsString(cmd_item) || cmd_item->valuestring == NULL ||
+        !cJSON_IsObject(args_item)) {
+        return app_mqtt_v1_error(id, "invalid_argument", "cmd/args required");
+    }
+    cmd = cmd_item->valuestring;
+    ctx.auth_level = APP_CMD_AUTH_LOCAL_TOKEN;
+    policy = app_cmd_policy_check_network(&ctx, cmd);
+    if (policy != APP_CMD_POLICY_ALLOW) {
+        const char *code = policy == APP_CMD_POLICY_BUSY ? "busy"
+                         : policy == APP_CMD_POLICY_NOT_ENABLED ? "forbidden"
+                         : policy == APP_CMD_POLICY_INVALID_ARGUMENT ? "invalid_argument"
+                         : "forbidden";
+        return app_mqtt_v1_error(id, code,
+                                 policy == APP_CMD_POLICY_NOT_ENABLED
+                                     ? "mqtt network transaction is disabled"
+                                     : cmd);
+    }
+
+    if (strcmp(cmd, "network.tryconnect") == 0 ||
+        strcmp(cmd, "network.apply") == 0 ||
+        strcmp(cmd, "network.cancel") == 0) {
+        bool ok;
+        const char *err = NULL;
+        cJSON *result = NULL;
+
+        if (strcmp(cmd, "network.tryconnect") == 0) {
+            ok = app_cmd_net_tryconnect_adapter(&ctx, args_item, &result, &err);
+        } else if (strcmp(cmd, "network.apply") == 0) {
+            ok = app_cmd_net_apply_adapter(&ctx, args_item, &result, &err);
+        } else {
+            ok = app_cmd_net_cancel_adapter(&ctx, args_item, &result, &err);
+        }
+        if (!ok) {
+            cJSON_Delete(result);
+            return app_mqtt_v1_error(id, app_cmd_v1_error_code(err), err);
+        }
+        return app_mqtt_v1_ok(id, result);
+    }
+
+    if (strcmp(cmd, "network.status") == 0 || strcmp(cmd, "operation.get") == 0) {
+        cJSON *frame = cJSON_CreateObject();
+        cJSON *params = cJSON_Duplicate(args_item, 1);
+        cJSON *result = NULL;
+        app_cmd_result_t out = {0};
+        const char *err = NULL;
+
+        if (frame == NULL || params == NULL) {
+            cJSON_Delete(frame);
+            cJSON_Delete(params);
+            return app_mqtt_v1_error(id, "internal_error", "out_of_memory");
+        }
+        cJSON_AddStringToObject(frame, "method", cmd);
+        cJSON_AddItemToObject(frame, "params", params);
+        if (app_cmd_execute_ctx(&ctx, frame, &result, &out, &err) != ESP_OK ||
+            result == NULL) {
+            cJSON_Delete(frame);
+            cJSON_Delete(result);
+            return app_mqtt_v1_error(id, app_cmd_v1_error_code(err), err);
+        }
+        cJSON_Delete(frame);
+        return app_mqtt_v1_ok(id, result);
+    }
+
+    return app_mqtt_v1_error(id, "unknown_command", cmd);
+}

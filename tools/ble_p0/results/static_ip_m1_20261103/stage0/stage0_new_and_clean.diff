diff --git a/tests/cmd_policy/test_cmd_policy.c b/tests/cmd_policy/test_cmd_policy.c
new file mode 100644
index 0000000..ed01445
--- /dev/null
+++ b/tests/cmd_policy/test_cmd_policy.c
@@ -0,0 +1,126 @@
+#include <stdio.h>
+#include <string.h>
+
+#include "cmd_policy.h"
+
+static int g_pass;
+static int g_fail;
+
+#define CHECK(cond)                                                          \
+    do {                                                                     \
+        if (cond) {                                                          \
+            g_pass++;                                                        \
+        } else {                                                             \
+            g_fail++;                                                        \
+            printf("  FAIL  %s:%d  %s\n", __FILE__, __LINE__, #cond);        \
+        }                                                                    \
+    } while (0)
+
+static app_cmd_context_t entry(app_cmd_source_t source, app_cmd_auth_level_t auth)
+{
+    app_cmd_context_t ctx = app_cmd_ctx_entry(source);
+
+    ctx.auth_level = auth;
+    return ctx;
+}
+
+static void test_classify(void)
+{
+    CHECK(app_cmd_kind("network.status") == APP_CMD_KIND_NET_STATUS);
+    CHECK(app_cmd_kind("network.tryconnect") == APP_CMD_KIND_NET_TRY);
+    CHECK(app_cmd_kind("network.apply") == APP_CMD_KIND_NET_APPLY);
+    CHECK(app_cmd_kind("network.cancel") == APP_CMD_KIND_NET_CANCEL);
+    CHECK(app_cmd_kind("operation.get") == APP_CMD_KIND_OPERATION_GET);
+    CHECK(app_cmd_kind("network.profile.delete") == APP_CMD_KIND_NET_PROFILE_DELETE);
+    CHECK(app_cmd_kind("config.set") == APP_CMD_KIND_CONFIG_SET);
+    CHECK(app_cmd_kind("device.info") == APP_CMD_KIND_OTHER);
+    CHECK(app_cmd_is_async_method("network.apply.async"));
+    CHECK(!app_cmd_is_async_method("network.apply"));
+    CHECK(app_cmd_is_network_method("network.apply"));
+    CHECK(!app_cmd_is_network_method("device.info"));
+}
+
+static void test_policy_sources(void)
+{
+    app_cmd_context_t ble = entry(APP_CMD_SOURCE_BLE, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t mqtt = entry(APP_CMD_SOURCE_MQTT, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t http = entry(APP_CMD_SOURCE_HTTP, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t touch = entry(APP_CMD_SOURCE_TOUCH, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t internal = {0};
+
+    CHECK(app_cmd_policy_check_network(&ble, "network.apply") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&ble, "network.apply.async") == APP_CMD_POLICY_FORBIDDEN);
+    CHECK(app_cmd_policy_check_network(&ble, "network.status") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&ble, "network.profile.delete") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&ble, "network.scan") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&ble, "device.info") == APP_CMD_POLICY_ALLOW);
+
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.status") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&mqtt, "operation.get") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.tryconnect") == APP_CMD_POLICY_NOT_ENABLED);
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.apply") == APP_CMD_POLICY_NOT_ENABLED);
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.cancel") == APP_CMD_POLICY_NOT_ENABLED);
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.profile.delete") == APP_CMD_POLICY_FORBIDDEN);
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.scan") == APP_CMD_POLICY_FORBIDDEN);
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.restart") == APP_CMD_POLICY_FORBIDDEN);
+
+    CHECK(app_cmd_policy_check_network(&http, "network.apply") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&touch, "network.apply") == APP_CMD_POLICY_FORBIDDEN);
+
+    CHECK(app_cmd_ctx_internal_child(&ble, &internal));
+    CHECK(app_cmd_policy_check_network(&internal, "network.apply") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&internal, "network.tryconnect") == APP_CMD_POLICY_FORBIDDEN);
+    CHECK(app_cmd_policy_check_network(&internal, "network.apply.async") == APP_CMD_POLICY_FORBIDDEN);
+}
+
+static void test_apply_owner(void)
+{
+    app_cmd_context_t ble = entry(APP_CMD_SOURCE_BLE, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t mqtt = entry(APP_CMD_SOURCE_MQTT, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t child = {0};
+
+    CHECK(app_cmd_policy_check_apply_owner(&ble, APP_OPERATION_OWNER_BLE) == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_apply_owner(&ble, APP_OPERATION_OWNER_MQTT) == APP_CMD_POLICY_FORBIDDEN);
+    CHECK(app_cmd_policy_check_apply_owner(&mqtt, APP_OPERATION_OWNER_MQTT) == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_ctx_internal_child(&mqtt, &child));
+    CHECK(app_cmd_policy_check_apply_owner(&child, APP_OPERATION_OWNER_MQTT) == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_apply_owner(&child, APP_OPERATION_OWNER_BLE) == APP_CMD_POLICY_FORBIDDEN);
+}
+
+static void test_cancel_matrix(void)
+{
+    app_cmd_context_t ble = entry(APP_CMD_SOURCE_BLE, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t mqtt = entry(APP_CMD_SOURCE_MQTT, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t http = entry(APP_CMD_SOURCE_HTTP, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t touch = entry(APP_CMD_SOURCE_TOUCH, APP_CMD_AUTH_LOCAL_TOKEN);
+    app_cmd_context_t ble_unauth = entry(APP_CMD_SOURCE_BLE, APP_CMD_AUTH_NONE);
+
+    CHECK(app_cmd_cancel_allowed(&ble, APP_OPERATION_OWNER_BLE));
+    CHECK(app_cmd_cancel_allowed(&ble, APP_OPERATION_OWNER_MQTT));
+    CHECK(app_cmd_cancel_allowed(&ble, APP_OPERATION_OWNER_HTTP));
+    CHECK(app_cmd_cancel_allowed(&mqtt, APP_OPERATION_OWNER_MQTT));
+    CHECK(!app_cmd_cancel_allowed(&mqtt, APP_OPERATION_OWNER_BLE));
+    CHECK(!app_cmd_cancel_allowed(&mqtt, APP_OPERATION_OWNER_HTTP));
+    CHECK(app_cmd_cancel_allowed(&http, APP_OPERATION_OWNER_HTTP));
+    CHECK(!app_cmd_cancel_allowed(&http, APP_OPERATION_OWNER_MQTT));
+    CHECK(!app_cmd_cancel_allowed(&http, APP_OPERATION_OWNER_BLE));
+    CHECK(!app_cmd_cancel_allowed(&touch, APP_OPERATION_OWNER_BLE));
+    CHECK(!app_cmd_cancel_allowed(&ble_unauth, APP_OPERATION_OWNER_BLE));
+}
+
+static void test_build_variant(void)
+{
+    CHECK(strcmp(app_cmd_policy_build_variant(), "mqtt_net_txn=off") == 0);
+    CHECK(!app_cmd_mqtt_net_txn_enabled());
+}
+
+int main(void)
+{
+    test_classify();
+    test_policy_sources();
+    test_apply_owner();
+    test_cancel_matrix();
+    test_build_variant();
+    printf("cmd_policy: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail == 0 ? 0 : 1;
+}
diff --git a/tests/cmd_policy/test_cmd_policy_flags.c b/tests/cmd_policy/test_cmd_policy_flags.c
new file mode 100644
index 0000000..6a26610
--- /dev/null
+++ b/tests/cmd_policy/test_cmd_policy_flags.c
@@ -0,0 +1,30 @@
+#include <stdio.h>
+#include <string.h>
+
+#include "cmd_policy.h"
+
+static int g_fail;
+
+#define CHECK(cond)                                                          \
+    do {                                                                     \
+        if (!(cond)) {                                                       \
+            g_fail++;                                                        \
+            printf("  FAIL  %s:%d  %s\n", __FILE__, __LINE__, #cond);        \
+        }                                                                    \
+    } while (0)
+
+int main(void)
+{
+    app_cmd_context_t mqtt = app_cmd_ctx_entry(APP_CMD_SOURCE_MQTT);
+
+    mqtt.auth_level = APP_CMD_AUTH_LOCAL_TOKEN;
+    CHECK(app_cmd_mqtt_net_txn_enabled());
+    CHECK(strcmp(app_cmd_policy_build_variant(), "mqtt_net_txn=test") == 0);
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.tryconnect") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.apply") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_policy_check_network(&mqtt, "network.cancel") == APP_CMD_POLICY_ALLOW);
+    CHECK(app_cmd_cancel_allowed(&mqtt, APP_OPERATION_OWNER_MQTT));
+    CHECK(!app_cmd_cancel_allowed(&mqtt, APP_OPERATION_OWNER_BLE));
+    printf("cmd_policy(test-build): %s\n", g_fail == 0 ? "PASS" : "FAIL");
+    return g_fail == 0 ? 0 : 1;
+}

diff --git a/main/cmd_policy.h b/main/cmd_policy.h
new file mode 100644
index 0000000..45a2a2e
--- /dev/null
+++ b/main/cmd_policy.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <stdbool.h>
+
+#include "cmd_context.h"
+#include "operation.h"
+
+/* Stage 0 command policy: pure source/method/owner decisions.
+ * No Wi-Fi/MQTT/cJSON dependencies; host-testable. */
+
+#ifndef APP_CMD_MQTT_NET_TXN_ENABLE
+#define APP_CMD_MQTT_NET_TXN_ENABLE 0
+#endif
+
+/* A test build must opt in explicitly; a production build must never set the
+ * transaction switch without the test marker. */
+#if APP_CMD_MQTT_NET_TXN_ENABLE && !defined(APP_CMD_MQTT_NET_TXN_TEST_BUILD)
+#error "APP_CMD_MQTT_NET_TXN_ENABLE requires APP_CMD_MQTT_NET_TXN_TEST_BUILD"
+#endif
+
+typedef enum {
+    APP_CMD_POLICY_ALLOW = 0,
+    APP_CMD_POLICY_FORBIDDEN,
+    APP_CMD_POLICY_BUSY,
+    APP_CMD_POLICY_INVALID_ARGUMENT,
+    APP_CMD_POLICY_NOT_ENABLED,
+} app_cmd_policy_result_t;
+
+typedef enum {
+    APP_CMD_KIND_OTHER = 0,
+    APP_CMD_KIND_NET_STATUS,
+    APP_CMD_KIND_NET_TRY,
+    APP_CMD_KIND_NET_APPLY,
+    APP_CMD_KIND_NET_CANCEL,
+    APP_CMD_KIND_OPERATION_GET,
+    APP_CMD_KIND_NET_PROFILE_DELETE,
+    APP_CMD_KIND_NET_SCAN,
+    APP_CMD_KIND_NET_RESTART,
+    APP_CMD_KIND_CONFIG_SET,
+} app_cmd_kind_t;
+
+app_cmd_kind_t app_cmd_kind(const char *method);
+bool app_cmd_is_async_method(const char *method);
+bool app_cmd_is_network_method(const char *method);
+
+/* External command-plane decision. `.async` is never an entry method; internal
+ * apply children use `network.apply`, not `.async`. */
+app_cmd_policy_result_t app_cmd_policy_check_network(const app_cmd_context_t *ctx,
+                                                     const char *method);
+
+/* Apply must be performed by the same owner that created the transaction.
+ * INTERNAL children inherit the origin owner. */
+app_cmd_policy_result_t app_cmd_policy_check_apply_owner(const app_cmd_context_t *ctx,
+                                                         app_operation_owner_t owner);
+
+/* Cancel requires an authenticated caller and a matching operation owner.
+ * BLE is the field-rescue channel and may cancel any network owner. */
+bool app_cmd_cancel_allowed(const app_cmd_context_t *ctx,
+                            app_operation_owner_t owner);
+
+bool app_cmd_mqtt_net_txn_enabled(void);
+const char *app_cmd_policy_build_variant(void);
diff --git a/main/cmd_policy.c b/main/cmd_policy.c
new file mode 100644
index 0000000..f9e169a
--- /dev/null
+++ b/main/cmd_policy.c
@@ -0,0 +1,186 @@
+#include <string.h>
+
+#include "cmd_policy.h"
+
+static bool app_cmd_source_is_entry(app_cmd_source_t source)
+{
+    return source == APP_CMD_SOURCE_MQTT || source == APP_CMD_SOURCE_BLE ||
+           source == APP_CMD_SOURCE_HTTP || source == APP_CMD_SOURCE_TOUCH ||
+           source == APP_CMD_SOURCE_SERIAL;
+}
+
+static app_operation_owner_t app_cmd_ctx_owner(const app_cmd_context_t *ctx)
+{
+    app_cmd_source_t source;
+
+    if (ctx == NULL) {
+        return APP_OPERATION_OWNER_INTERNAL;
+    }
+    source = (ctx->exec_env == APP_CMD_EXEC_INTERNAL) ? ctx->origin : ctx->source;
+    switch (source) {
+    case APP_CMD_SOURCE_BLE:  return APP_OPERATION_OWNER_BLE;
+    case APP_CMD_SOURCE_HTTP: return APP_OPERATION_OWNER_HTTP;
+    case APP_CMD_SOURCE_MQTT: return APP_OPERATION_OWNER_MQTT;
+    default:                  return APP_OPERATION_OWNER_INTERNAL;
+    }
+}
+
+app_cmd_kind_t app_cmd_kind(const char *method)
+{
+    if (method == NULL) {
+        return APP_CMD_KIND_OTHER;
+    }
+    if (strcmp(method, "network.status") == 0) return APP_CMD_KIND_NET_STATUS;
+    if (strcmp(method, "network.tryconnect") == 0) return APP_CMD_KIND_NET_TRY;
+    if (strcmp(method, "network.apply") == 0) return APP_CMD_KIND_NET_APPLY;
+    if (strcmp(method, "network.cancel") == 0) return APP_CMD_KIND_NET_CANCEL;
+    if (strcmp(method, "operation.get") == 0) return APP_CMD_KIND_OPERATION_GET;
+    if (strcmp(method, "network.profile.delete") == 0) return APP_CMD_KIND_NET_PROFILE_DELETE;
+    if (strcmp(method, "network.scan") == 0) return APP_CMD_KIND_NET_SCAN;
+    if (strcmp(method, "network.restart") == 0) return APP_CMD_KIND_NET_RESTART;
+    if (strcmp(method, "config.set") == 0 || strcmp(method, "setConfig") == 0) {
+        return APP_CMD_KIND_CONFIG_SET;
+    }
+    return APP_CMD_KIND_OTHER;
+}
+
+bool app_cmd_is_async_method(const char *method)
+{
+    size_t len;
+
+    if (method == NULL) {
+        return false;
+    }
+    len = strlen(method);
+    return len >= 6 && strcmp(method + len - 6, ".async") == 0;
+}
+
+bool app_cmd_is_network_method(const char *method)
+{
+    app_cmd_kind_t kind = app_cmd_kind(method);
+
+    return kind >= APP_CMD_KIND_NET_STATUS && kind <= APP_CMD_KIND_NET_RESTART;
+}
+
+app_cmd_policy_result_t app_cmd_policy_check_network(const app_cmd_context_t *ctx,
+                                                     const char *method)
+{
+    app_cmd_kind_t kind;
+    bool internal;
+    app_cmd_source_t entry_source;
+
+    if (ctx == NULL || !app_cmd_ctx_valid(ctx)) {
+        return APP_CMD_POLICY_FORBIDDEN;
+    }
+    if (method == NULL) {
+        return APP_CMD_POLICY_ALLOW;
+    }
+    if (app_cmd_is_async_method(method)) {
+        /* No external or internal caller uses `.async` as a method now. The
+         * legal adapters call the internal API directly. */
+        return APP_CMD_POLICY_FORBIDDEN;
+    }
+    if (!app_cmd_is_network_method(method)) {
+        return APP_CMD_POLICY_ALLOW;
+    }
+
+    internal = (ctx->exec_env == APP_CMD_EXEC_INTERNAL);
+    entry_source = internal ? ctx->origin : ctx->source;
+    if (!app_cmd_source_is_entry(entry_source)) {
+        return APP_CMD_POLICY_FORBIDDEN;
+    }
+
+    kind = app_cmd_kind(method);
+
+    /* Internal apply child: only the commit of an existing operation. */
+    if (internal) {
+        return kind == APP_CMD_KIND_NET_APPLY ? APP_CMD_POLICY_ALLOW
+                                              : APP_CMD_POLICY_FORBIDDEN;
+    }
+
+    switch (entry_source) {
+    case APP_CMD_SOURCE_MQTT:
+        if (kind == APP_CMD_KIND_NET_PROFILE_DELETE || kind == APP_CMD_KIND_NET_SCAN ||
+            kind == APP_CMD_KIND_NET_RESTART) {
+            return APP_CMD_POLICY_FORBIDDEN;
+        }
+        if (kind == APP_CMD_KIND_NET_TRY || kind == APP_CMD_KIND_NET_APPLY ||
+            kind == APP_CMD_KIND_NET_CANCEL) {
+            return app_cmd_mqtt_net_txn_enabled() ? APP_CMD_POLICY_ALLOW
+                                                  : APP_CMD_POLICY_NOT_ENABLED;
+        }
+        return APP_CMD_POLICY_ALLOW; /* status / operation.get (owner checked later) */
+
+    case APP_CMD_SOURCE_BLE:
+    case APP_CMD_SOURCE_HTTP:
+        return (kind == APP_CMD_KIND_NET_PROFILE_DELETE || kind == APP_CMD_KIND_NET_SCAN ||
+                kind == APP_CMD_KIND_NET_RESTART || kind == APP_CMD_KIND_NET_STATUS ||
+                kind == APP_CMD_KIND_NET_TRY || kind == APP_CMD_KIND_NET_APPLY ||
+                kind == APP_CMD_KIND_NET_CANCEL || kind == APP_CMD_KIND_OPERATION_GET)
+                   ? APP_CMD_POLICY_ALLOW
+                   : APP_CMD_POLICY_FORBIDDEN;
+
+    default:
+        return APP_CMD_POLICY_FORBIDDEN;
+    }
+}
+
+app_cmd_policy_result_t app_cmd_policy_check_apply_owner(const app_cmd_context_t *ctx,
+                                                         app_operation_owner_t owner)
+{
+    app_operation_owner_t caller;
+
+    if (ctx == NULL || !app_cmd_ctx_valid(ctx)) {
+        return APP_CMD_POLICY_FORBIDDEN;
+    }
+    caller = app_cmd_ctx_owner(ctx);
+    if (caller == APP_OPERATION_OWNER_INTERNAL) {
+        return APP_CMD_POLICY_FORBIDDEN;
+    }
+    return caller == owner ? APP_CMD_POLICY_ALLOW : APP_CMD_POLICY_FORBIDDEN;
+}
+
+bool app_cmd_cancel_allowed(const app_cmd_context_t *ctx,
+                            app_operation_owner_t owner)
+{
+    app_cmd_source_t source;
+
+    if (ctx == NULL || !app_cmd_ctx_valid(ctx) ||
+        ctx->auth_level != APP_CMD_AUTH_LOCAL_TOKEN) {
+        return false;
+    }
+    if (ctx->exec_env != APP_CMD_EXEC_ENTRY) {
+        return false;
+    }
+    source = ctx->source;
+
+    switch (source) {
+    case APP_CMD_SOURCE_BLE:
+        return owner == APP_OPERATION_OWNER_BLE || owner == APP_OPERATION_OWNER_MQTT ||
+               owner == APP_OPERATION_OWNER_HTTP;
+    case APP_CMD_SOURCE_MQTT:
+        return owner == APP_OPERATION_OWNER_MQTT;
+    case APP_CMD_SOURCE_HTTP:
+        return owner == APP_OPERATION_OWNER_HTTP;
+    default:
+        return false;
+    }
+}
+
+bool app_cmd_mqtt_net_txn_enabled(void)
+{
+#if APP_CMD_MQTT_NET_TXN_ENABLE
+    return true;
+#else
+    return false;
+#endif
+}
+
+const char *app_cmd_policy_build_variant(void)
+{
+#if APP_CMD_MQTT_NET_TXN_ENABLE
+    return "mqtt_net_txn=test";
+#else
+    return "mqtt_net_txn=off";
+#endif
+}
diff --git a/main/cmd_cfg_txn.h b/main/cmd_cfg_txn.h
new file mode 100644
index 0000000..4fb63dd
--- /dev/null
+++ b/main/cmd_cfg_txn.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Stage 0 config-transaction gate. State is protected by app_config_lock
+ * (recursive); no separate long-held lock is introduced. */
+
+typedef struct {
+    uint32_t token;
+} app_cmd_cfg_txn_t;
+
+/* Claim a network transaction. Returns false if one is already active. */
+bool app_cmd_cfg_txn_begin(app_cmd_cfg_txn_t *out);
+
+/* Release only if the active token matches. Idempotent for stale tokens. */
+bool app_cmd_cfg_txn_end(app_cmd_cfg_txn_t txn);
+
+/* Enter the config-write gate. On true the caller holds app_config_lock and
+ * must call guard_exit() after the write. On false the lock is already
+ * released and the caller must return busy.
+ *
+ * Long-term constraint: while the gate is held, do not call Wi-Fi/MQTT APIs,
+ * wait on the network, or invoke callbacks that may re-enter config. NVS stays
+ * on the existing app_config_lock path; no new long-held lock is introduced. */
+bool app_cmd_cfg_txn_guard_enter(void);
+void app_cmd_cfg_txn_guard_exit(void);
+
+bool app_cmd_cfg_txn_active(void);
diff --git a/main/cmd_cfg_txn.c b/main/cmd_cfg_txn.c
new file mode 100644
index 0000000..4982873
--- /dev/null
+++ b/main/cmd_cfg_txn.c
@@ -0,0 +1,74 @@
+#include <stddef.h>
+
+#include "cmd_cfg_txn.h"
+
+/* Implemented by config.c. Kept as externs so this module stays host-testable. */
+void app_config_lock(void);
+void app_config_unlock(void);
+
+static bool s_active;
+static uint32_t s_token;
+static uint32_t s_next_token;
+
+bool app_cmd_cfg_txn_begin(app_cmd_cfg_txn_t *out)
+{
+    bool ok = false;
+
+    if (out == NULL) {
+        return false;
+    }
+    app_config_lock();
+    if (!s_active) {
+        uint32_t next = s_next_token + 1;
+
+        if (next == 0) {
+            next = 1;
+        }
+        s_next_token = next;
+        s_token = next;
+        s_active = true;
+        out->token = next;
+        ok = true;
+    }
+    app_config_unlock();
+    return ok;
+}
+
+bool app_cmd_cfg_txn_end(app_cmd_cfg_txn_t txn)
+{
+    bool released = false;
+
+    app_config_lock();
+    if (s_active && txn.token != 0 && txn.token == s_token) {
+        s_active = false;
+        s_token = 0;
+        released = true;
+    }
+    app_config_unlock();
+    return released;
+}
+
+bool app_cmd_cfg_txn_guard_enter(void)
+{
+    app_config_lock();
+    if (s_active) {
+        app_config_unlock();
+        return false;
+    }
+    return true;
+}
+
+void app_cmd_cfg_txn_guard_exit(void)
+{
+    app_config_unlock();
+}
+
+bool app_cmd_cfg_txn_active(void)
+{
+    bool active;
+
+    app_config_lock();
+    active = s_active;
+    app_config_unlock();
+    return active;
+}

diff --git a/tests/cmd_cfg_txn/test_cmd_cfg_txn.c b/tests/cmd_cfg_txn/test_cmd_cfg_txn.c
new file mode 100644
index 0000000..f5f783c
--- /dev/null
+++ b/tests/cmd_cfg_txn/test_cmd_cfg_txn.c
@@ -0,0 +1,75 @@
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <stdio.h>
+
+#include "cmd_cfg_txn.h"
+
+static pthread_mutex_t g_lock;
+static int g_pass;
+static int g_fail;
+
+#define CHECK(cond)                                                          \
+    do {                                                                     \
+        if (cond) {                                                          \
+            g_pass++;                                                        \
+        } else {                                                             \
+            g_fail++;                                                        \
+            printf("  FAIL  %s:%d  %s\n", __FILE__, __LINE__, #cond);        \
+        }                                                                    \
+    } while (0)
+
+void app_config_lock(void)
+{
+    pthread_mutex_lock(&g_lock);
+}
+
+void app_config_unlock(void)
+{
+    pthread_mutex_unlock(&g_lock);
+}
+
+int main(void)
+{
+    app_cmd_cfg_txn_t a = {0};
+    app_cmd_cfg_txn_t b = {0};
+    pthread_mutexattr_t attr;
+
+    pthread_mutexattr_init(&attr);
+    pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
+    pthread_mutex_init(&g_lock, &attr);
+    pthread_mutexattr_destroy(&attr);
+
+    CHECK(!app_cmd_cfg_txn_active());
+    CHECK(app_cmd_cfg_txn_begin(&a));
+    CHECK(a.token != 0);
+    CHECK(app_cmd_cfg_txn_active());
+    CHECK(!app_cmd_cfg_txn_begin(&b));      /* one transaction only */
+    CHECK(!app_cmd_cfg_txn_guard_enter());  /* config.set must be busy */
+
+    CHECK(!app_cmd_cfg_txn_end((app_cmd_cfg_txn_t){0}));
+    CHECK(!app_cmd_cfg_txn_end((app_cmd_cfg_txn_t){a.token + 1}));
+    CHECK(app_cmd_cfg_txn_active());        /* stale token must not release */
+
+    CHECK(app_cmd_cfg_txn_end(a));
+    CHECK(!app_cmd_cfg_txn_active());
+    CHECK(app_cmd_cfg_txn_guard_enter());   /* free gate can be held */
+    app_cmd_cfg_txn_guard_exit();
+
+    CHECK(app_cmd_cfg_txn_begin(&b));
+    CHECK(b.token != a.token);
+    CHECK(!app_cmd_cfg_txn_end(a));         /* old token after re-claim */
+    CHECK(app_cmd_cfg_txn_active());
+    CHECK(app_cmd_cfg_txn_end(b));
+    CHECK(!app_cmd_cfg_txn_active());
+
+    /* auth.admin.set uses the same guard: a transaction must make it busy. */
+    CHECK(app_cmd_cfg_txn_begin(&a));
+    CHECK(!app_cmd_cfg_txn_guard_enter());
+    CHECK(app_cmd_cfg_txn_end(a));
+    CHECK(app_cmd_cfg_txn_guard_enter());
+    app_cmd_cfg_txn_guard_exit();
+
+    printf("cmd_cfg_txn: %d passed, %d failed\n", g_pass, g_fail);
+    pthread_mutex_destroy(&g_lock);
+    return g_fail == 0 ? 0 : 1;
+}
